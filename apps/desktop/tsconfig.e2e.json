{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@renderer/*": ["./src/renderer/src/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": ["e2e/**/*.ts", "e2e/**/*.tsx", "e2e/**/*.mts", "src/renderer/src/env.d.ts"]
}
