# build / binaries
build/
dist/
*.o
*.a
*.dylib
*.so
*.dll
*.metallib

# python
__pycache__/
*.pyc
.venv/
.venv*/
uv.lock

# node
node_modules/
.pnpm-store/
apps/desktop/out/
# Keep release source files tracked; ignore only generated upload artifacts.
/release/artifacts/
coverage/
*.tsbuildinfo

# local data (never commit weights)
models/
outputs/
runs/
# ...but not source folders that happen to be called models (pages/models, test/*/models).
!apps/desktop/src/**/models/
!apps/desktop/test/**/models/
.dev-data/
*.safetensors
*.mnn
*.mnn.weight
*.onnx
*.gguf

# env
.env
.env.*
!.env.example

# tooling
.upstream/
.DS_Store
.idea/
.vscode/
.agents/
.claude/
.omc/
.codex/
.cursor/
.mcp.json
*.log

# AI 会话恢复与实施计划（仅本地保留）
docs/requirements.md
docs/initial-plan.md

# ------------------------------------------------------------------
# docs/assets: only the folders of images that docs embed are tracked
# (docs/reference/documentation-guidelines.md, images). Stray test or render
# output stays local. A new folder gets its own ! line.
# ------------------------------------------------------------------
docs/assets/*
!docs/assets/brand/
!docs/assets/readme/

# Agent state inside docs/ (the root .omc/ pattern is anchored)
docs/.omc/
