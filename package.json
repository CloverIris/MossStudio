{
  "name": "mossstudio",
  "version": "1.0.2",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "scripts": {
    "dev": "pnpm --filter @clover/desktop dev",
    "build": "pnpm --filter @clover/desktop build",
    "typecheck": "pnpm --filter @clover/desktop typecheck",
    "smoke": "pnpm --filter @clover/desktop smoke",
    "test:settings-draft": "node tools/test-settings-draft.mjs",
    "test:ssh-manager": "node --test tools/test-ssh-manager.mjs",
    "test:download-queue": "node --test tools/test-download-queue.mjs",
    "test:ui": "node tools/test-ui.mjs --scaled",
    "test:studio": "node tools/test-ui.mjs --studio",
    "release:md": "node tools/release-md.mjs",
    "release:md:check": "node tools/release-md.mjs --check",
    "release:build": "pnpm typecheck && pnpm build && node tools/build-release.mjs",
    "test:models": "node --test tests/model-files.test.mjs",
    "test:gpu-studio": "node --test tests/gpu-profile.test.mjs tests/gpu-compatibility.test.mjs tests/gpu-scheduling.test.mjs tests/studio-canvas-branch.test.mjs",
    "test:model-imports": "node --test tests/model-imports.test.mjs",
    "test:model-runtime": "python -m unittest discover -s runner/tests"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0"
  }
}
